{
  "name": "wbs-qa-tech-challenge",
  "version": "1.0.0",
  "description": "WBS QA Engineer Tech Challenge – Playwright + TypeScript (API + UI) with Allure",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --headed",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:serve": "allure serve allure-results",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "ui-testing",
    "allure",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
}
